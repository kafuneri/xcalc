# 站点个性化配置模板（复制为 .env.local 进行本地配置，或在 EdgeOne 控制台「环境变量」中填写）
# 所有字段均可选；留空时界面不会渲染对应的外链、备案信息或统计脚本

# 1. 站点分析脚本（如 Umami / 自建统计，留空则不加载）
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_WEBSITE_ID=

# 2. Vercount 访问量统计脚本（留空则不加载且隐藏页脚统计）
VITE_VERCOUNT_SRC=

# 3. 顶栏右上方小字外链（格式：名称|链接，多个用英文逗号分隔）
# 示例：GitHub|https://github.com/yourname,Blog|https://blog.example.com/,Home|https://example.com
VITE_TOP_LINKS=

# 4. 页脚公安备案与 ICP 备案（留空则隐藏对应条目）
VITE_MPS_BEIAN_TEXT=
VITE_MPS_BEIAN_CODE=
VITE_ICP_BEIAN_TEXT=

# 5. 可选服务端 AI 复盘密钥（仅服务端边缘函数/Vite中间件读取，不打包进前端；按优先级 1 -> 2 -> 3 自动降级）
# 优先级 1：智谱免费模型 glm-4.7-flash（open.bigmodel.cn）
ZHIPU_API_KEY=
# 优先级 2：Cloudflare Workers AI（@cf/google/gemma-4-26b-a4b-it，关闭思考）
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 优先级 3：EdgeOne Makers AI 网关（仅调用绑定的 google/gemini-*，不耗 @makers 额度）
AI_GATEWAY_API_KEY=
# 可选兜底：未配 Makers 网关时直接调用 Google AI Studio Gemini API
GEMINI_API_KEY=
