# 站点个性化配置模板（复制为 .env.local 进行本地配置，或在 EdgeOne 控制台「环境变量」中填写）
# 所有字段均可选；留空时界面不会渲染对应的外链、备案信息或统计脚本

# 1. 站点分析脚本（如 Umami / 自建统计，留空则不加载）
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_WEBSITE_ID=

# 2. Vercount 访问量统计脚本（留空则不加载且隐藏页脚统计）
VITE_VERCOUNT_SRC=

# 3. 顶栏右上方小字外链（格式：名称|链接，多个用英文逗号分隔）
# 示例：GitHub|https://github.com/yourname,Blog|https://blog.example.com/,Home|https://example.com
VITE_TOP_LINKS=

# 4. 页脚公安备案与 ICP 备案（留空则隐藏对应条目）
VITE_MPS_BEIAN_TEXT=
VITE_MPS_BEIAN_CODE=
VITE_ICP_BEIAN_TEXT=

# 5. 可选服务端 AI 复盘配置（仅服务端边缘函数/Vite中间件读取，不打包进前端；按优先级 1 -> 2 -> 3 -> 4 自动降级，最多支持 AI_1_* 到 AI_10_*）
# 优先级 1
AI_1_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<your-account-id>/ai/v1
AI_1_API_KEY=your-api-key
AI_1_MODEL=@cf/google/gemma-4-26b-a4b-it
AI_1_FIRST_TOKEN_MS=5000
AI_1_TIMEOUT_MS=25000
AI_1_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# 优先级 2
AI_2_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_2_API_KEY=your-api-key
AI_2_MODEL=google/gemini-3.5-flash-lite
AI_2_FIRST_TOKEN_MS=10000
AI_2_TIMEOUT_MS=20000

# 优先级 3
AI_3_BASE_URL=https://integrate.api.nvidia.com/v1
AI_3_API_KEY=your-api-key
AI_3_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AI_3_FIRST_TOKEN_MS=3000
AI_3_TIMEOUT_MS=20000
AI_3_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# 优先级 4
AI_4_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_4_API_KEY=your-api-key
AI_4_MODEL=glm-4.7-flash
AI_4_FIRST_TOKEN_MS=10000
AI_4_TIMEOUT_MS=15000
AI_4_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 优先级 5
AI_5_BASE_URL=https://integrate.api.nvidia.com/v1
AI_5_API_KEY=your-api-key
AI_5_MODEL=minimaxai/minimax-m3.1-flash
AI_5_FIRST_TOKEN_MS=15000
AI_5_TIMEOUT_MS=35000
AI_5_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# 优先级 6
AI_6_BASE_URL=https://integrate.api.nvidia.com/v1
AI_6_API_KEY=your-api-key
AI_6_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_6_FIRST_TOKEN_MS=15000
AI_6_TIMEOUT_MS=35000
AI_6_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
