{
  "nodeVersion": "24.18.0",
  "installCommand": "npm install -g pnpm@10.25.0 && pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
